<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#101827">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NIT3213"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:textColor="#48DCCB"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Welcome back."
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="36sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sign in to explore your digital library."
            android:textColor="#A9B3C3"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="STUDENT ID"
            android:textColor="#D3DCE8"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.12"/>

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your student ID"
            android:inputType="number"
            android:singleLine="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8291A5"
            android:textSize="15sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="FIRST NAME"
            android:textColor="#D3DCE8"
            android:textStyle="bold"
            android:textSize="12sp"
            android:letterSpacing="0.12"/>

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your first name"
            android:inputType="textPassword"
            android:singleLine="true"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8291A5"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="34dp"
            android:text="SIGN IN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#101827"
            android:backgroundTint="#48DCCB"/>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#FF8080"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:text="VICTORIA UNIVERSITY  •  ANDROID APPLICATION"
            android:textColor="#78879B"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:gravity="center"/>

    </LinearLayout>
</ScrollView>
